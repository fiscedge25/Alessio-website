# ─── Newsletter: collect (Supabase) ───────────────────────────────
# Supabase → Project Settings → API
# SUPABASE_URL              = "Project URL"
# SUPABASE_SERVICE_ROLE_KEY = "service_role" secret (server-side only — NEVER expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Newsletter: send (Resend) ─────────────────────────────────────
# RESEND_API_KEY          = API key from resend.com/api-keys
# NEWSLETTER_FROM         = verified sender, e.g. "Alessio Sabatino <news@alessiosabatino.it>"
#                           (requires verifying your domain in Resend; until then use "onboarding@resend.dev")
# NEWSLETTER_ADMIN_SECRET = a long random string; required in the Authorization header to trigger a send
# NEXT_PUBLIC_SITE_URL    = canonical site origin, e.g. https://www.builtwithsabba.com
RESEND_API_KEY=
NEWSLETTER_FROM=
NEWSLETTER_ADMIN_SECRET=
NEXT_PUBLIC_SITE_URL=

# ─── Engagement (ideas voting / suggestions / project inquiries) ────────────
# Same Supabase project. Run supabase/engagement.sql once to create tables.
# Writes go through Next.js API routes only; nothing is exposed client-side.

# ─── GitHub (optional, server-side only) ─────────────────────────────────────
# Public repos need no token. Add one ONLY for higher rate limits.
# NEVER prefix with NEXT_PUBLIC_.
# GITHUB_TOKEN=
